<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EBEBCC"
    tools:context=".PrincipalActivity">

    <ScrollView
        android:id="@+id/scrollPrincipal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Encabezado de BookLingo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BookLingo"
                android:textColor="#4B7D58"
                android:textSize="30sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Learn English, one word at a time"
                android:textColor="#594646"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- Bloque de seleccion de idiomas -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selecciona los idiomas:"
                android:textColor="#594646"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="#C8D6CC"
                app:strokeWidth="1dp">

                <Spinner
                    android:id="@+id/spIdiomas"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:paddingHorizontal="12dp"
                    android:backgroundTint="#594646" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Bloque de texto a traducir -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Escribe el texto:"
                android:textColor="#4B7D58"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="#A8E6CF"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/etTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="105dp"
                    android:padding="14dp"
                    android:background="@android:color/transparent"
                    android:gravity="top|start"
                    android:hint="Write something..."
                    android:inputType="textCapSentences|textMultiLine"
                    android:textColor="#000000"
                    android:textColorHint="#8C8888"
                    android:textSize="15sp" />
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnTraducir"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="18dp"
                android:text="Traducir"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="12dp" />

            <!-- Bloque de resultado -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Traducción"
                android:textColor="#4B7D58"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="90dp"
                android:padding="14dp"
                android:background="#D8EBDC"
                android:text="La traducción aparecerá aquí..."
                android:textColor="#594646"
                android:textSize="16sp"
                android:gravity="center_vertical" />

            <Button
                android:id="@+id/btnIrGuardar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Continuar"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#EBEBCC"
        app:itemIconTint="@color/black"
        app:itemTextColor="@color/black"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_botton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>