<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101818"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BookLingo"
            android:textColor="#A8E6CF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guardar traduccion"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Revisa la informacion de tu traduccion antes de guardarla."
            android:textColor="#B8C7C2"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Idiomas utilizados"
            android:textColor="#A8E6CF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvIdiomas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#263432"
            android:text="English → Español"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="16dp"
            android:layout_marginBottom="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Texto original"
            android:textColor="#A8E6CF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvTextoOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:background="#263432"
            android:text="Aqui aparecera el texto original"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:padding="16dp"
            android:gravity="top"
            android:layout_marginBottom="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Traduccion"
            android:textColor="#A8E6CF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvTextoTraducido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="35dp"
            android:background="#263432"
            android:gravity="top"
            android:minHeight="100dp"
            android:padding="16dp"
            android:text="Aqui aparecera la traduccion"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Guardar traduccion"
            android:textColor="#101818"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#A8E6CF"
            android:layout_marginBottom="15dp" />

        <Button
            android:id="@+id/btnRegresar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Regresar"
            android:textColor="#A8E6CF"
            android:textSize="16sp"
            android:backgroundTint="#263432" />

    </LinearLayout>

</ScrollView>
