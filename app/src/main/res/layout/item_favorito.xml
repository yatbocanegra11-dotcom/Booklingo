<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#C8D6CC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvItemIdiomas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="English → Español"
            android:textColor="#4B7D58"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvItemOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Texto original"
            android:textColor="#101818"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvItemTraducido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Texto traducido"
            android:textColor="#594646"
            android:textSize="15sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toca para quitar de favoritos"
            android:textColor="#8C8888"
            android:textSize="12sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>